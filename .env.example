# =============================================================================
# Komüte Driver Verifier v2 - Example configuration
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
#
#   Copy-Item .env.example .env
#
# Load precedence (highest wins): repo-root .env > backend/.env > ./.env
# The service logs a loud ERROR at startup if two files define the same
# credential with different values.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloud VLM Provider
# -----------------------------------------------------------------------------
# One of: openai_compatible | anthropic | mock
# `mock` is refused when ENVIRONMENT=production.
VLM_PROVIDER=openai_compatible

# Ordered model-level fallbacks. Tried one-by-one, so a single retired or
# unavailable model ID is skipped without poisoning the whole provider.
VLM_MODEL_FALLBACKS=

# Ordered provider-level failover. The configured VLM_PROVIDER is always tried
# first regardless of where it appears here. Providers without credentials are
# skipped and recorded in the attempt chain.
VLM_FALLBACK_CHAIN=openai_compatible,anthropic

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
# Anthropic: must start with "sk-ant-".
# NOTE: claude-3-5-sonnet-20241022 was retired in Oct 2025. Use claude-sonnet-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI-compatible gateway. All three values are required for this provider to
# be considered usable; a missing one reports `no_credentials` / `config_error`
# at /api/v1/diagnostics/vlm and degrades Stage 2 to SERVICE_UNAVAILABLE.
# The primary deployment is the 9Router gateway at https://our-llm.onrender.com/v1
#   VLM_API_BASE_URL=https://our-llm.onrender.com/v1
#   VLM_API_KEY=<9Router bearer token>
#   VLM_OPENAI_MODEL=<model id served by the gateway; see GET /v1/models>
VLM_API_BASE_URL=https://our-llm.onrender.com/v1
VLM_API_KEY=
VLM_OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Deterministic mock provider (local / CI only; refused in production)
# -----------------------------------------------------------------------------
MOCK_VLM_MATCH=true
MOCK_VLM_CONFIDENCE=0.95
MOCK_VLM_LIVENESS=true

# -----------------------------------------------------------------------------
# Scoring Mode & Composite Acceptance Criteria
# -----------------------------------------------------------------------------
# "field_average" (average of all field matching percentages) or "stage_weighted"
SCORING_MODE=field_average

# Global Approval Threshold: Average matching score required to APPROVE verification (0.70 = 70%)
COMPOSITE_APPROVAL_THRESHOLD=0.70

# When false, individual stage boolean failures do not block approval if overall average >= COMPOSITE_APPROVAL_THRESHOLD
STRICT_STAGE_PASS_REQUIRED=false

# When true, critical safety triggers (underage, expired card, selfie spoof, VLM outage) enforce rejection
ENFORCE_HARD_REJECTIONS=true

# -----------------------------------------------------------------------------
# Field-Level Matching Weights (used when SCORING_MODE=field_average)
# Set all to 1.0 for equal arithmetic average, or adjust weights as desired
# -----------------------------------------------------------------------------
FIELD_WEIGHT_NAME=1.0
FIELD_WEIGHT_DL_NUMBER=1.0
FIELD_WEIGHT_DOB=1.0
FIELD_WEIGHT_EXPIRY=1.0
FIELD_WEIGHT_FACE=1.0
FIELD_WEIGHT_PLATE=1.0
FIELD_WEIGHT_COLOR=1.0

# -----------------------------------------------------------------------------
# Thresholds & Calibration (Binary Pass / Fail)
# -----------------------------------------------------------------------------
FUZZY_NAME_THRESHOLD=0.85
FUZZY_DL_THRESHOLD=0.88
# Field-level OCR gates, on the 0-100 similarity scale used by dl_ocr.
FUZZY_DOB_THRESHOLD=80.0
FUZZY_EXPIRY_THRESHOLD=80.0
REGION_GATE_SCORE=75.0
SEVERE_BLUR_VARIANCE=20.0
VLM_MIN_MATCH_CONFIDENCE=0.70
FACE_CROP_PADDING_RATIO=0.15

# -----------------------------------------------------------------------------
# Composite stage weights (used when SCORING_MODE=stage_weighted, must sum to 1.0)
# -----------------------------------------------------------------------------
STAGE1_WEIGHT=0.30
STAGE2_WEIGHT=0.45
STAGE3_WEIGHT=0.25
STAGE3_PLATE_WEIGHT=0.75
STAGE3_COLOR_WEIGHT=0.25
VLM_MISMATCH_FLOOR=0.50
PLATE_HARD_FLOOR=0.40
PLATE_REVIEW_FLOOR=0.85

# -----------------------------------------------------------------------------
# Vehicle ALPR gates
# -----------------------------------------------------------------------------
PLATE_MATCH_THRESHOLD=0.85
COLOR_AGREEMENT_MIN=0.15

# -----------------------------------------------------------------------------
# Face detector sensitivity
# -----------------------------------------------------------------------------
FACE_YUNET_SCORE=0.50
FACE_YUNET_NMS=0.30
FACE_VERIFY_THRESHOLD=0.45
FACE_NMS_SCORE=0.40
FACE_NMS_IOU=0.35

# -----------------------------------------------------------------------------
# OCR engine sensitivity
# -----------------------------------------------------------------------------
OCR_BOX_THRESH=0.38
OCR_DB_THRESH=0.20
OCR_UNCLIP_RATIO=1.95
OCR_WORKING_MAX_DIM=1200
OCR_USE_CLS=false
STAGE1_RECOVERY_BUDGET_SECONDS=10.0

# -----------------------------------------------------------------------------
# Image quality gates
# -----------------------------------------------------------------------------
BLUR_VARIANCE_MIN=40.0
GLARE_RATIO_MAX=0.30
NOISE_VARIANCE_MAX=5000.0

# -----------------------------------------------------------------------------
# VLM call shaping
# -----------------------------------------------------------------------------
VLM_MAX_TOKENS=900
VLM_CONNECTIVITY_MAX_TOKENS=8
VLM_TEMPERATURE=0
VLM_REPAIR_CONTEXT_CHARS=800
VLM_USE_RESPONSE_FORMAT=true

# -----------------------------------------------------------------------------
# Uploads, previews, telemetry
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=15
PREVIEW_MAX_DIM=1400
TELEMETRY_DEFAULT_LIMIT=50
TELEMETRY_CACHE_TTL=30.0

# -----------------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------------
# PIPELINE_TIMEOUT_SECONDS is the ceiling for all three stages.
# VLM_TOTAL_TIMEOUT_SECONDS must stay at or below 60% of it so a slow VLM is
# never misreported as a pipeline timeout. The service clamps and warns if not.
PIPELINE_TIMEOUT_SECONDS=45.0
VLM_CALL_TIMEOUT_SECONDS=12.0
VLM_TOTAL_TIMEOUT_SECONDS=25.0
VLM_PARSE_RETRY_COUNT=1

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Resolved relative to the repository root, so it does not depend on the
# directory uvicorn was started from.
UPLOADS_DIR=storage/uploads

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print('kmt_live_' + secrets.token_urlsafe(24))"
API_SECRET_KEY=
ENABLE_API_KEY_AUTH=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60.0
RATE_LIMIT_MAX_IPS=2000

# Comma-separated allowlist. Leaving this empty DISABLES cross-origin browser
# access, which is the safe default. The previous "*" + credentials pairing was
# unsafe and has been removed.
CORS_ALLOW_ORIGINS=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Native thread-pool sizes (only applied when unset: .env / host env wins)
# -----------------------------------------------------------------------------
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
VECLIB_MAXIMUM_THREADS=2
NUMEXPR_NUM_THREADS=2
ORT_INTRA_OP_NUM_THREADS=2
ORT_INTER_OP_NUM_THREADS=1
