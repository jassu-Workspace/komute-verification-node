                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All subsystem tests passed', () => { const d = pm.response.json(); Object.values(d).forEach(v => { if (v && typeof v === 'object') { pm.expect(v.test_passed || v.status === 'operational').to.be.true; } }); });"
                ]
