      "name": "Core Verification",
      "item": [
        {
          "name": "POST /api/v1/verify (APPROVED Scenario)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/verify",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"req_postman_001\",\n  \"driver_id\": \"driver_postman_001\",\n  \"personal_info\": {\n    \"full_name\": \"John Smith\",\n    \"email_address\": \"john.smith@email.com\",\n    \"mobile_number\": \"+14165551234\",\n    \"date_of_birth\": \"1990-05-15\",\n    \"gender\": \"Male\",\n    \"role\": \"Driver\"\n  },\n  \"license_details\": {\n    \"license_number\": \"DL1234567\",\n    \"issuing_province\": \"ON\",\n    \"license_expiry_date\": \"2028-12-31\"\n  },\n  \"vehicle_details\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Camry\",\n    \"year\": 2022,\n    \"color\": \"White\",\n    \"plate\": \"CMBY815\"\n  },\n  \"images\": {\n    \"selfie_base64\": \"REPLACE_WITH_BASE64_SELFIE\",\n    \"license_image_base64\": \"REPLACE_WITH_BASE64_DL_IMAGE\",\n    \"vehicle_photo_base64\": \"REPLACE_WITH_BASE64_VEHICLE_IMAGE\"\n  }\n}"
            },
            "description": "Full 3-stage verification — expects APPROVED or REJECTED with all stage results"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Decision is APPROVED or REJECTED', () => pm.expect(d.decision).to.be.oneOf(['APPROVED','REJECTED']));",
                  "pm.test('Service is not degraded', () => { pm.expect(d).to.have.property('service_status'); pm.expect(d.service_status, 'Stage 2 VLM unavailable -> ' + JSON.stringify(d.degraded_subsystems)).to.eql('ok'); });",
                  "pm.test('No degraded subsystems', () => pm.expect(d.degraded_subsystems).to.eql([]));",
                  "pm.test('VLM stage actually executed', () => { const v = d.stages.face_biometrics; pm.expect(v.verdict, 'VLM verdict was ' + v.verdict).to.not.eql('SERVICE_UNAVAILABLE'); pm.expect(v.vlm_provider_used, 'no provider reported - the VLM never executed').to.be.a('string'); pm.expect(v.vlm_provider_used).to.not.be.empty; });",
                  "pm.test('VLM attempt chain populated', () => { const c = d.stages.face_biometrics.vlm_attempt_chain; pm.expect(c).to.be.an('array').that.is.not.empty; pm.expect(c[0]).to.have.property('provider'); pm.expect(c[0]).to.have.property('ok'); });",
                  "pm.test('VLM confidence within 0..1', () => pm.expect(d.stages.face_biometrics.vlm_confidence).to.be.within(0, 1));",
                  "pm.test('Composite confidence between 0 and 1', () => pm.expect(d.composite_confidence).to.be.within(0, 1));",
                  "pm.test('Execution time positive', () => pm.expect(d.execution_time_ms).to.be.above(0));",
                  "pm.test('Has all three stages', () => { pm.expect(d.stages).to.have.property('license_ocr'); pm.expect(d.stages).to.have.property('face_biometrics'); pm.expect(d.stages).to.have.property('vehicle_verification'); });"
                ]
              }
            }
          ]
        },
