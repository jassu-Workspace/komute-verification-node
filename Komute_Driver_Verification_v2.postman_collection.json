        {
          "name": "VLM Diagnostics (offline probe)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/diagnostics/vlm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "diagnostics",
                "vlm"
              ]
            },
            "description": "Phase 0: reports which VLM providers are configured, whether each credential has a plausible shape, which .env files were loaded, and the classified reason for the last failure. No network call is made."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Reports provider fallback chain', () => { pm.expect(d.provider_fallback_chain).to.be.an('array').that.is.not.empty; pm.expect(d.provider_fallback_chain[0]).to.eql(d.primary_provider); });",
                  "pm.test('Reports model fallbacks', () => pm.expect(d.model_fallbacks).to.be.an('array').that.is.not.empty);",
                  "pm.test('Each provider reports key shape validity', () => { d.providers.forEach(p => { pm.expect(p).to.have.property('key_shape_valid'); pm.expect(p).to.have.property('ready'); }); });",
                  "pm.test('No key-shape mismatches', () => pm.expect(d.key_shape_mismatches, 'Mismatched: ' + JSON.stringify(d.key_shape_mismatches)).to.eql([]));",
                  "pm.test('At least one provider is usable', () => pm.expect(d.vlm_ready, 'No VLM provider is usable. See providers[] for per-provider blocking_reason.').to.be.true);",
                  "pm.test('Env file precedence reported', () => { pm.expect(d.env_sources).to.have.property('precedence_order'); pm.expect(d.env_sources).to.have.property('conflicts'); });",
                  "pm.test('No duplicate env files reported', () => { const f = d.env_sources.loaded_files; pm.expect(new Set(f).size).to.eql(f.length); });",
                  "pm.test('Timeout budget fits inside pipeline budget', () => { const t = d.timeout_budget; pm.expect(t.vlm_total_timeout_seconds).to.be.below(t.pipeline_timeout_seconds); });",
                  "pm.test('No raw credential in payload', () => { pm.expect(JSON.stringify(d.providers.map(p => p.key_masked))).to.not.include('AIza'); });"
                ]
              }
            }
          ]
        },
