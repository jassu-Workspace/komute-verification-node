  "item": [
    {
      "name": "Health & Diagnostics",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Primary health check — returns subsystem status, uptime, memory usage"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Health status is healthy or degraded', () => { const d = pm.response.json(); pm.expect(d.status).to.be.oneOf(['healthy', 'degraded']); });",
                  "pm.test('OCR available', () => pm.expect(pm.response.json().ocr_available).to.be.true);",
                  "pm.test('Face detector available', () => pm.expect(pm.response.json().face_detector_available).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /ping",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ping",
            "description": "Ultra-fast ping probe for load balancers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Ping returns pong', () => pm.expect(pm.response.json().ping).to.eql('pong'));"
                ]
              }
            }
          ]
        },
