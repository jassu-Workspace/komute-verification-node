    {
      "name": "Core Verification",
      "item": [
        {
          "name": "POST /api/v1/verify (APPROVED Scenario)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/verify",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"req_postman_001\",\n  \"driver_id\": \"driver_postman_001\",\n  \"personal_info\": {\n    \"full_name\": \"John Smith\",\n    \"email_address\": \"john.smith@email.com\",\n    \"mobile_number\": \"+14165551234\",\n    \"date_of_birth\": \"1990-05-15\",\n    \"gender\": \"Male\",\n    \"role\": \"Driver\"\n  },\n  \"license_details\": {\n    \"license_number\": \"DL1234567\",\n    \"issuing_province\": \"ON\",\n    \"license_expiry_date\": \"2028-12-31\"\n  },\n  \"vehicle_details\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Camry\",\n    \"year\": 2022,\n    \"color\": \"White\",\n    \"plate\": \"CMBY815\"\n  },\n  \"images\": {\n    \"selfie_base64\": \"REPLACE_WITH_BASE64_SELFIE\",\n    \"license_image_base64\": \"REPLACE_WITH_BASE64_DL_IMAGE\",\n    \"vehicle_photo_base64\": \"REPLACE_WITH_BASE64_VEHICLE_IMAGE\"\n  }\n}"
            },
            "description": "Full 3-stage verification — expects APPROVED or REJECTED with all stage results"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Decision is APPROVED or REJECTED', () => { const d = pm.response.json(); pm.expect(d.decision).to.be.oneOf(['APPROVED', 'REJECTED']); });",
                  "pm.test('Composite confidence between 0 and 1', () => { const d = pm.response.json(); pm.expect(d.composite_confidence).to.be.within(0, 1); });",
                  "pm.test('Execution time positive', () => pm.expect(pm.response.json().execution_time_ms).to.be.above(0));",
                  "pm.test('Has license_ocr stage', () => pm.expect(pm.response.json().stages).to.have.property('license_ocr'));",
                  "pm.test('Has face_biometrics stage', () => pm.expect(pm.response.json().stages).to.have.property('face_biometrics'));",
                  "pm.test('Has vehicle_verification stage', () => pm.expect(pm.response.json().stages).to.have.property('vehicle_verification'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/verify (REJECTED — Expired License)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/verify",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"req_postman_expired_001\",\n  \"driver_id\": \"driver_postman_expired_001\",\n  \"personal_info\": {\n    \"full_name\": \"Jane Doe\",\n    \"date_of_birth\": \"1985-03-20\"\n  },\n  \"license_details\": {\n    \"license_number\": \"DL9999999\",\n    \"issuing_province\": \"ON\",\n    \"license_expiry_date\": \"2020-01-01\"\n  },\n  \"vehicle_details\": {\n    \"plate\": \"ABC1234\",\n    \"color\": \"Blue\"\n  },\n  \"images\": {\n    \"selfie_base64\": \"REPLACE_WITH_BASE64_SELFIE\",\n    \"license_image_base64\": \"REPLACE_WITH_BASE64_DL_IMAGE\",\n    \"vehicle_photo_base64\": \"REPLACE_WITH_BASE64_VEHICLE_IMAGE\"\n  }\n}"
            },
            "description": "Verify with expired license — expects REJECTED with expired reason"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Decision is REJECTED', () => pm.expect(pm.response.json().decision).to.eql('REJECTED'));",
                  "pm.test('Has rejection reasons', () => { const d = pm.response.json(); pm.expect(d.rejection_reasons).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/privacy-crop-preview",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/privacy-crop-preview",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"REPLACE_WITH_BASE64_DL_IMAGE\",\n  \"margin_ratio\": 0.15\n}"
            },
            "description": "Zero-PII face isolation preview — returns cropped face with PII sanitized"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('face_detected is boolean', () => pm.expect(pm.response.json().face_detected).to.be.a('boolean'));",
                  "pm.test('PII sanitized when face detected', () => { const d = pm.response.json(); if (d.face_detected) { pm.expect(d.pii_sanitized).to.be.true; pm.expect(d.face_crop_base64).to.not.be.null; } });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/compress",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/compress",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\path\\to\\test_image.png"
                },
                {
                  "key": "compressionPercentage",
                  "value": "80",
                  "type": "text"
                },
                {
                  "key": "format",
                  "value": "webp",
                  "type": "text"
                },
                {
                  "key": "maxWidth",
                  "value": "1400",
                  "type": "text"
                }
              ]
            },
            "description": "Compress image to WebP/AVIF — check response headers X-Original-Size, X-Compressed-Size"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is image', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image'));",
                  "pm.test('Compression saved bytes', () => { const orig = parseInt(pm.response.headers.get('X-Original-Size')); const comp = parseInt(pm.response.headers.get('X-Compressed-Size')); pm.expect(comp).to.be.below(orig); });"
                ]
              }
            }
          ]
        }
      ]
    },
