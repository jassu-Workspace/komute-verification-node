    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "401 — No API Key",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/verify",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Request without X-API-Key — should return 401"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Error mentions API key', () => pm.expect(pm.response.json().detail).to.include('API-Key'));"
                ]
              }
            }
          ]
        },
        {
          "name": "401 — Wrong API Key",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/verify",
            "header": [
              {
                "key": "X-API-Key",
                "value": "wrong_key_12345",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Request with incorrect API key — should return 401"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "422 — Missing Required Fields",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/verify",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"req_incomplete\"\n}"
            },
            "description": "Request with missing required fields — should return 422"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Storage",
      "item": [
        {
          "name": "GET /api/v1/storage/{file_path}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/storage/sessions/test/file.webp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "storage", "sessions", "test", "file.webp"]
            },
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "description": "Serve saved verification artifact — test with path traversal: ../../etc/passwd"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200, 403, or 404', () => pm.response.to.have.status.oneOf([200, 403, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "403 — Path Traversal Attack",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/storage/../../etc/passwd",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "storage", "..", "..", "etc", "passwd"]
            },
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "description": "Path traversal attack — should return 403 Forbidden"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('Error mentions access denied', () => pm.expect(pm.response.json().detail).to.include('Access denied'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
