        {
          "name": "POST /api/v1/verify (Degraded Mode Expectation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"req_postman_001\",\n  \"driver_id\": \"driver_postman_001\",\n  \"personal_info\": {\n    \"full_name\": \"John Smith\",\n    \"email_address\": \"john.smith@email.com\",\n    \"mobile_number\": \"+14165551234\",\n    \"date_of_birth\": \"1990-05-15\",\n    \"gender\": \"Male\",\n    \"role\": \"Driver\"\n  },\n  \"license_details\": {\n    \"license_number\": \"DL1234567\",\n    \"issuing_province\": \"ON\",\n    \"license_expiry_date\": \"2028-12-31\"\n  },\n  \"vehicle_details\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Camry\",\n    \"year\": 2022,\n    \"color\": \"White\",\n    \"plate\": \"CMBY815\"\n  },\n  \"images\": {\n    \"selfie_base64\": \"REPLACE_WITH_BASE64_SELFIE\",\n    \"license_image_base64\": \"REPLACE_WITH_BASE64_DL_IMAGE\",\n    \"vehicle_photo_base64\": \"REPLACE_WITH_BASE64_VEHICLE_IMAGE\"\n  }\n}"
            },
            "description": "Same request as the APPROVED scenario, but asserts the DEGRADED contract. Run this against the 'Komute VLM Disabled' environment (empty VLM keys) to prove that an infrastructure outage is reported as service_status='degraded' with a machine-readable reason, instead of silently passing as a legitimate REJECTED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is still 200 (by design)', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Decision is REJECTED', () => pm.expect(d.decision).to.eql('REJECTED'));",
                  "pm.test('Service status is degraded', () => pm.expect(d.service_status).to.eql('degraded'));",
                  "pm.test('Degraded subsystem is named', () => { pm.expect(d.degraded_subsystems).to.be.an('array').that.is.not.empty; pm.expect(d.degraded_subsystems[0].name).to.eql('cloud_vlm_biometrics'); });",
                  "pm.test('Degraded reason is machine-readable', () => { pm.expect(d.degraded_subsystems[0].reason).to.be.oneOf(['no_credentials','invalid_credentials','quota_exhausted','model_unavailable','provider_unreachable','timeout','unparseable_response','sdk_missing','config_error','provider_error']); });",
                  "pm.test('Stage 2 failed closed', () => { const v = d.stages.face_biometrics; pm.expect(v.verdict).to.eql('SERVICE_UNAVAILABLE'); pm.expect(v.passed).to.be.false; pm.expect(v.is_match).to.be.false; pm.expect(v.vlm_confidence).to.eql(0); });"
                ]
              }
            }
          ]
        }
