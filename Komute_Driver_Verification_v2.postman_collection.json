                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Decision is REJECTED', () => pm.expect(d.decision).to.eql('REJECTED'));",
